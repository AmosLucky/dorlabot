# ============================================================================
# DORLA MESSENGER AUTOMATION — ENVIRONMENT CONFIGURATION TEMPLATE
# ----------------------------------------------------------------------------
# 1. Copy this file:            cp .env.example .env
# 2. Generate application key:  php artisan key:generate
# 3. Fill in the values marked  replace_with_...  or  YOUR_..._HERE
# 4. Never commit your real .env to version control.
#
# The application BOOTS and all non-Facebook features work with placeholders.
# Live Facebook/Meta operations stay DISABLED until real Meta credentials are
# configured — the UI shows a clear configuration warning instead.
# ============================================================================

APP_NAME="Dorla Messenger Automation"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://dorlacode.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ----------------------------------------------------------------------------
# DATABASE (MySQL / MariaDB — recommended for production)
# ----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=replace_with_database_name
DB_USERNAME=replace_with_database_username
DB_PASSWORD=replace_with_database_password

# ----------------------------------------------------------------------------
# SESSIONS / CACHE / QUEUES
# database queue driver works on ANY host (no daemon needed, see README).
# Use redis + a persistent supervisor worker when your hosting supports it.
# ----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=database

CACHE_STORE=file
FILESYSTEM_DISK=local

# Optional — when your host supports Redis:
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# ----------------------------------------------------------------------------
# MAIL (required for verification, password reset and contact notifications)
# ----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=YOUR_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=YOUR_SMTP_USERNAME
MAIL_PASSWORD=YOUR_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@dorlacode.com
MAIL_FROM_NAME="${APP_NAME}"

# ----------------------------------------------------------------------------
# META / FACEBOOK — PLACEHOLDERS. Fill with real values from
# https://developers.facebook.com/apps  (see docs/META_APP_SETUP.md)
# ----------------------------------------------------------------------------
META_APP_ID=YOUR_META_APP_ID_HERE
META_APP_SECRET=YOUR_META_APP_SECRET_HERE
META_LOGIN_CONFIG_ID=YOUR_META_LOGIN_CONFIG_ID_HERE
META_WEBHOOK_VERIFY_TOKEN=REPLACE_WITH_A_RANDOM_SECRET
META_GRAPH_API_VERSION=v23.0
META_REDIRECT_URI=https://dorlacode.com/auth/meta/callback
META_APP_URL=https://dorlacode.com

# Permissions requested during Facebook Login (comma separated, no spaces).
# See docs/PERMISSIONS.md before changing these.
META_PERMISSIONS="pages_show_list,pages_messaging,pages_manage_metadata,pages_read_engagement,pages_read_user_content,business_management"

# ----------------------------------------------------------------------------
# PLATFORM SETTINGS
# ----------------------------------------------------------------------------
# Super-admin created by the database seeder:
ADMIN_SUPER_EMAIL=admin@dorlacode.com
ADMIN_SUPER_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
ADMIN_SUPER_NAME="Dorla Admin"

# Development simulation mode — MUST be false in production.
# When true (local only), webhook/automation flows can be exercised with
# clearly-labeled SIMULATED Meta events. Never enable on production.
DORLA_SIMULATION=false

# Platform defaults (overridable later in the super-admin dashboard)
DORLA_DEFAULT_FREE_PAGE_LIMIT=1
DORLA_DEFAULT_CONTACT_LIMIT=1000
DORLA_DEFAULT_MONTHLY_BROADCAST_LIMIT=10
